rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Sem login: quem conhece o código da partida pode ler e jogar.
    // As regras só limitam o formato dos dados.
    match /partidas/{codigo} {
      allow read: if true;
      // "modo": master, linear ou pokemon (o primeiro modo temático, só com perguntas de pokémon); partidas sem "modo"
      // são Master. A Trilha da Vida ("trilha") saiu do app em 2026-10-27: partidas novas dela não são mais aceitas.
      // "semente" (Linear): sorteia a ordem dos temas nas casas. "perguntas": "multipla" sorteia só perguntas de
      // múltipla escolha; partidas sem o campo são completas.
      allow create: if codigo.matches('^[A-Z]{4}$')
                    && request.resource.data.criada_em == request.time
                    && ((request.resource.data.keys().hasOnly(['criada_em', 'modo', 'semente', 'perguntas'])
                         && (!('semente' in request.resource.data) || request.resource.data.semente is int)
                         && (!('perguntas' in request.resource.data) || request.resource.data.perguntas == 'multipla')
                         && (!('modo' in request.resource.data) || request.resource.data.modo in ['master', 'linear', 'pokemon']))
                        // Arena (2026-11-23): criada pela tela grande, com login anônimo; "anfitriao" é o uid dela, o único
                        // que muda a partida depois. "prazo": segundos para responder.
                        || (request.resource.data.keys().hasOnly(['criada_em', 'modo', 'semente', 'perguntas', 'anfitriao', 'prazo'])
                            && request.resource.data.modo == 'arena'
                            && request.auth != null && request.resource.data.anfitriao == request.auth.uid
                            && request.resource.data.semente is int
                            && request.resource.data.perguntas == 'multipla'
                            && prazoValido(request.resource.data.prazo)));
      // "vez" é o id do jogador da vez. "atual" é a pergunta em jogo, para o modo mesa (sem a resposta), ou null.
      // "som" é o último evento de som ({e, n}), que a tela grande toca. "anterior" é a rodada encerrada antes da
      // atual (o mesmo formato de "atual"), que a tela grande pode mostrar de novo.
      // Duração da partida (2026-10-28): "inicio" é gravado uma vez, no primeiro sorteio; "fim" quando o primeiro peão
      // chega à última casa, com "duracao" em segundos (até 7 dias).
      allow update: if resource.data.get('modo', 'master') != 'arena'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vez', 'atual', 'som', 'anterior', 'inicio', 'fim', 'duracao'])
                    && (!('inicio' in request.resource.data.diff(resource.data).affectedKeys())
                        || (!('inicio' in resource.data) && request.resource.data.inicio == request.time))
                    && (!('fim' in request.resource.data.diff(resource.data).affectedKeys())
                        || request.resource.data.fim == request.time)
                    && (!('duracao' in request.resource.data.diff(resource.data).affectedKeys())
                        || (request.resource.data.duracao is int && request.resource.data.duracao >= 0
                            && request.resource.data.duracao <= 604800))
                    && (!('som' in request.resource.data)
                        || (request.resource.data.som is map && request.resource.data.som.size() <= 2))
                    && (!('vez' in request.resource.data)
                        || (request.resource.data.vez is string && request.resource.data.vez.size() <= 40))
                    && (!('atual' in request.resource.data) || request.resource.data.atual == null
                        || (request.resource.data.atual is map && request.resource.data.atual.size() <= 12))
                    && (!('anterior' in request.resource.data) || request.resource.data.anterior == null
                        || (request.resource.data.anterior is map && request.resource.data.anterior.size() <= 12));
      // Arena: só a tela grande (o anfitrião) muda a partida. "rodada" é a pergunta em jogo, para todos: n (o número
      // da rodada), pergunta (o id), tema, subtema, enunciado, opcoes (as 4 alternativas, na ordem da tela), figura,
      // prazo, inicio (hora do servidor), fase ("respondendo", "encerrada" ou "revelada") e, revelada, certa (o índice
      // da alternativa certa). "vencedores": os ids de quem chegou ao fim na mesma rodada. "experimental": o suspense antes
      // da resposta está ligado (2026-11-23, em teste). "capataz": o uid do jogador que a tela grande deixou comandar a
      // próxima pergunta e o modo automático; "automatico": o estado do modo automático, para o capataz ver.
      allow update: if resource.data.get('modo', 'master') == 'arena'
                    && request.auth != null && request.auth.uid == resource.data.anfitriao
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rodada', 'prazo', 'inicio', 'fim', 'duracao', 'vencedores', 'experimental',
                                                                                  'capataz', 'automatico'])
                    && (!('experimental' in request.resource.data) || request.resource.data.experimental is bool)
                    && (!('automatico' in request.resource.data) || request.resource.data.automatico is bool)
                    && (!('capataz' in request.resource.data) || request.resource.data.capataz == null
                        || (request.resource.data.capataz is string && request.resource.data.capataz.size() <= 128))
                    && (!('rodada' in request.resource.data)
                        || (request.resource.data.rodada is map && request.resource.data.rodada.size() <= 12
                            && request.resource.data.rodada.n is int
                            && request.resource.data.rodada.fase in ['respondendo', 'encerrada', 'revelada']
                            && request.resource.data.rodada.inicio is timestamp
                            && prazoValido(request.resource.data.rodada.prazo)
                            && request.resource.data.rodada.opcoes is list && request.resource.data.rodada.opcoes.size() == 4
                            && (!('rodada' in request.resource.data.diff(resource.data).affectedKeys())
                                || rodadaSegue(resource.data, request.resource.data))))
                    && prazoValido(request.resource.data.prazo)
                    && (!('inicio' in request.resource.data.diff(resource.data).affectedKeys())
                        || (!('inicio' in resource.data) && request.resource.data.inicio == request.time))
                    && (!('fim' in request.resource.data.diff(resource.data).affectedKeys())
                        || request.resource.data.fim == request.time)
                    && (!('duracao' in request.resource.data.diff(resource.data).affectedKeys())
                        || (request.resource.data.duracao is int && request.resource.data.duracao >= 0
                            && request.resource.data.duracao <= 604800))
                    && (!('vencedores' in request.resource.data)
                        || (request.resource.data.vencedores is list && request.resource.data.vencedores.size() <= 30));
      // Arena, capataz: só ele, e só o campo "comando" ({acao: "proxima" ou "automatico", n, em}), que a tela grande executa.
      allow update: if resource.data.get('modo', 'master') == 'arena'
                    && request.auth != null && resource.data.get('capataz', null) == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comando'])
                    && request.resource.data.comando is map
                    && request.resource.data.comando.keys().hasOnly(['acao', 'n', 'em'])
                    && request.resource.data.comando.acao in ['proxima', 'automatico']
                    && request.resource.data.comando.n is int
                    && request.resource.data.comando.em == request.time;

      // "pontos" é a casa do peão; "tema" é o tema do jogador no estágio 1 do Master.
      // Na Arena, o id do jogador é o uid do celular dele: só ele cria o próprio jogador e troca nome, cor ("tema") e avatar; só a
      // tela grande muda a casa: +1 no lote que revela a resposta, ou à mão, arrastando o peão (2026-11-23). A revelação
      // continua valendo uma vez só pela regra da partida (a ordem das fases). Sai o próprio jogador ou quem a tela grande
      // tirar.
      match /jogadores/{id} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['nome', 'pontos', 'tema', 'criado_em', 'avatar'])
                      && nomeValido(request.resource.data)
                      && avatarValido(request.resource.data)
                      && request.resource.data.pontos == 0
                      && temaValido(request.resource.data)
                      && request.resource.data.criado_em == request.time
                      && (!ehArena(codigo) || (request.auth != null && id == request.auth.uid));
        allow update: if !ehArena(codigo)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pontos', 'tema'])
                      && request.resource.data.pontos is int
                      && temaValido(request.resource.data);
        allow update: if ehArena(codigo) && request.auth != null
                      && ((request.auth.uid == partidaDe(codigo).anfitriao
                           && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pontos'])
                           && request.resource.data.pontos is int && request.resource.data.pontos >= 0
                           && request.resource.data.pontos <= 100)
                          || (request.auth.uid == id
                              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome', 'tema', 'avatar'])
                              && nomeValido(request.resource.data) && temaValido(request.resource.data)
                              && avatarValido(request.resource.data)));
        allow delete: if !ehArena(codigo)
                      || (request.auth != null && (request.auth.uid == id || request.auth.uid == partidaDe(codigo).anfitriao));
      }

      // Arena: a resposta de cada jogador em cada rodada, com o id "n_uid". Uma só, sem troca, gravada pelo próprio
      // jogador enquanto a rodada aceita respostas: fase "respondendo", mesmo depois do prazo (2026-11-23), até a tela
      // grande fechar a rodada.
      match /respostas/{id} {
        allow read: if true;
        allow create: if request.auth != null
                      && request.resource.data.keys().hasOnly(['n', 'jogador', 'opcao', 'em'])
                      && request.resource.data.jogador == request.auth.uid
                      && request.resource.data.n is int
                      && id == string(request.resource.data.n) + '_' + request.auth.uid
                      && request.resource.data.opcao is int
                      && request.resource.data.opcao >= 0 && request.resource.data.opcao <= 3
                      && request.resource.data.em == request.time
                      && rodadaAberta(codigo, request.resource.data.n)
                      && exists(/databases/$(database)/documents/partidas/$(codigo)/jogadores/$(request.auth.uid));
      }

      // Um registro por sorteio; a mesma pergunta pode sair mais de uma vez na partida. "dado" (modo Pokémon): de 1 a
      // 3, quantas casas anda quem acertar.
      match /sorteios/{id} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['pergunta', 'em', 'dado'])
                      && request.resource.data.pergunta is string
                      && request.resource.data.pergunta.size() <= 20
                      && (!('dado' in request.resource.data)
                          || (request.resource.data.dado is int && request.resource.data.dado >= 1 && request.resource.data.dado <= 3))
                      && request.resource.data.em == request.time;
        // "tentativas": a pergunta aberta passa adiante a cada erro; respondente e acertou são os da última.
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['respondente', 'acertou', 'tentativas'])
                      && request.resource.data.respondente is string
                      && request.resource.data.acertou is bool
                      && (!('tentativas' in request.resource.data)
                          || (request.resource.data.tentativas is list && request.resource.data.tentativas.size() <= 30));
      }

      // Formato antigo (até a v0.16): uma entrada por pergunta, com o id da pergunta. O app atual só lê
      // estas entradas; continua aceitando gravações para não quebrar um aparelho com a versão antiga aberta.
      match /usadas/{pergunta} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['em'])
                      && request.resource.data.em == request.time;
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['respondente', 'acertou'])
                      && request.resource.data.respondente is string
                      && request.resource.data.acertou is bool;
      }
    }

    // Avaliação de uma pergunta por quem a leu: um documento por sorteio (o id é o do sorteio), que quem lê
    // pode refazer enquanto quiser, mas sempre sobre a mesma pergunta. Ninguém apaga.
    // "dificuldade": 1 (muito fácil) a 5 (muito difícil), ou null; "problemas": códigos fixos.
    match /avaliacoes/{sorteio} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['pergunta', 'partida', 'dificuldade', 'otima', 'problemas', 'comentario', 'em'])
                    && request.resource.data.pergunta is string && request.resource.data.pergunta.size() <= 20
                    && request.resource.data.partida is string && request.resource.data.partida.size() <= 8
                    && (request.resource.data.dificuldade == null
                        || (request.resource.data.dificuldade is int && request.resource.data.dificuldade >= 1
                            && request.resource.data.dificuldade <= 5))
                    && request.resource.data.otima is bool
                    && request.resource.data.problemas is list
                    && request.resource.data.problemas.hasOnly(['fora_do_tema', 'resposta_errada', 'mais_de_uma_resposta',
                         'enunciado_confuso', 'entrega_resposta', 'figura_ruim', 'repetida', 'desatualizada'])
                    && request.resource.data.comentario is string && request.resource.data.comentario.size() <= 500
                    && request.resource.data.em == request.time
                    && (resource == null || resource.data.pergunta == request.resource.data.pergunta);
    }

    function partidaDe(codigo) {
      return get(/databases/$(database)/documents/partidas/$(codigo)).data;
    }
    function ehArena(codigo) {
      return partidaDe(codigo).get('modo', 'master') == 'arena';
    }
    function rodadaAberta(codigo, n) {
      let p = partidaDe(codigo);
      return p.get('modo', 'master') == 'arena' && p.rodada.n == n && p.rodada.fase == 'respondendo';
    }
    // Arena: a rodada só anda em ordem: "respondendo" → "encerrada" → "revelada" → a seguinte ("respondendo", n + 1).
    // Assim a revelação (e os peões que andam com ela) vale uma vez só.
    function rodadaSegue(antes, depois) {
      return (depois.rodada.fase == 'respondendo'
              && ((!('rodada' in antes) && depois.rodada.n == 1)
                  || ('rodada' in antes && antes.rodada.fase == 'revelada' && depois.rodada.n == antes.rodada.n + 1)))
          || ('rodada' in antes && depois.rodada.n == antes.rodada.n
              && ((depois.rodada.fase == 'encerrada' && antes.rodada.fase == 'respondendo')
                  || (depois.rodada.fase == 'revelada' && antes.rodada.fase == 'encerrada')));
    }
    function prazoValido(prazo) {
      return prazo is int && prazo >= 5 && prazo <= 120;
    }
    // Arena: o avatar do jogador, um identificador curto ("astronauta", "t-fla"…), de arena-avatares.js.
    function avatarValido(dados) {
      return !('avatar' in dados) || (dados.avatar is string && dados.avatar.size() > 0 && dados.avatar.size() <= 24);
    }
    function nomeValido(dados) {
      return dados.nome is string && dados.nome.size() > 0 && dados.nome.size() <= 30;
    }
    function temaValido(dados) {
      return !('tema' in dados) || (dados.tema is string && dados.tema.size() > 0 && dados.tema.size() <= 40);
    }
  }
}
