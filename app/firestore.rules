rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Sem login: quem conhece o código da partida pode ler e jogar.
    // As regras só limitam o formato dos dados.
    match /partidas/{codigo} {
      allow read: if true;
      // "modo": master, linear ou pokemon (o Linear só com perguntas de pokémon); partidas sem "modo" são Master. A
      // Trilha da Vida ("trilha") saiu do app em 2026-10-27: partidas novas dela não são mais aceitas. "perguntas":
      // "multipla" sorteia só perguntas de múltipla escolha; partidas sem o campo são completas.
      allow create: if codigo.matches('^[A-Z]{4}$')
                    && request.resource.data.keys().hasOnly(['criada_em', 'modo', 'perguntas'])
                    && (!('perguntas' in request.resource.data) || request.resource.data.perguntas == 'multipla')
                    && request.resource.data.criada_em == request.time
                    && (!('modo' in request.resource.data) || request.resource.data.modo in ['master', 'linear', 'pokemon']);
      // "vez" é o id do jogador da vez. "atual" é a pergunta em jogo, para o modo mesa (sem a resposta), ou null.
      // "som" é o último evento de som ({e, n}), que a tela grande toca. "anterior" é a rodada encerrada antes da
      // atual (o mesmo formato de "atual"), que a tela grande pode mostrar de novo.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vez', 'atual', 'som', 'anterior'])
                    && (!('som' in request.resource.data)
                        || (request.resource.data.som is map && request.resource.data.som.size() <= 2))
                    && (!('vez' in request.resource.data)
                        || (request.resource.data.vez is string && request.resource.data.vez.size() <= 40))
                    && (!('atual' in request.resource.data) || request.resource.data.atual == null
                        || (request.resource.data.atual is map && request.resource.data.atual.size() <= 12))
                    && (!('anterior' in request.resource.data) || request.resource.data.anterior == null
                        || (request.resource.data.anterior is map && request.resource.data.anterior.size() <= 12));

      // "pontos" é a casa do peão; "tema" é o tema do jogador no estágio 1 do Master.
      match /jogadores/{id} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['nome', 'pontos', 'tema', 'criado_em'])
                      && request.resource.data.nome is string
                      && request.resource.data.nome.size() > 0
                      && request.resource.data.nome.size() <= 30
                      && request.resource.data.pontos == 0
                      && temaValido(request.resource.data)
                      && request.resource.data.criado_em == request.time;
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pontos', 'tema'])
                      && request.resource.data.pontos is int
                      && temaValido(request.resource.data);
        allow delete: if true;
      }

      // Um registro por sorteio; a mesma pergunta pode sair mais de uma vez na partida. "dado" (modo Pokémon): de 1 a
      // 3, quantas casas anda quem acertar.
      match /sorteios/{id} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['pergunta', 'em', 'dado'])
                      && request.resource.data.pergunta is string
                      && request.resource.data.pergunta.size() <= 20
                      && (!('dado' in request.resource.data)
                          || (request.resource.data.dado is int && request.resource.data.dado >= 1 && request.resource.data.dado <= 3))
                      && request.resource.data.em == request.time;
        // "tentativas": a pergunta aberta passa adiante a cada erro; respondente e acertou são os da última.
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['respondente', 'acertou', 'tentativas'])
                      && request.resource.data.respondente is string
                      && request.resource.data.acertou is bool
                      && (!('tentativas' in request.resource.data)
                          || (request.resource.data.tentativas is list && request.resource.data.tentativas.size() <= 30));
      }

      // Formato antigo (até a v0.16): uma entrada por pergunta, com o id da pergunta. O app atual só lê
      // estas entradas; continua aceitando gravações para não quebrar um aparelho com a versão antiga aberta.
      match /usadas/{pergunta} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['em'])
                      && request.resource.data.em == request.time;
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['respondente', 'acertou'])
                      && request.resource.data.respondente is string
                      && request.resource.data.acertou is bool;
      }
    }

    // Avaliação de uma pergunta por quem a leu: um documento por sorteio (o id é o do sorteio), que quem lê
    // pode refazer enquanto quiser, mas sempre sobre a mesma pergunta. Ninguém apaga.
    // "dificuldade": 1 (muito fácil) a 5 (muito difícil), ou null; "problemas": códigos fixos.
    match /avaliacoes/{sorteio} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['pergunta', 'partida', 'dificuldade', 'otima', 'problemas', 'comentario', 'em'])
                    && request.resource.data.pergunta is string && request.resource.data.pergunta.size() <= 20
                    && request.resource.data.partida is string && request.resource.data.partida.size() <= 8
                    && (request.resource.data.dificuldade == null
                        || (request.resource.data.dificuldade is int && request.resource.data.dificuldade >= 1
                            && request.resource.data.dificuldade <= 5))
                    && request.resource.data.otima is bool
                    && request.resource.data.problemas is list
                    && request.resource.data.problemas.hasOnly(['fora_do_tema', 'resposta_errada', 'mais_de_uma_resposta',
                         'enunciado_confuso', 'entrega_resposta', 'figura_ruim', 'repetida', 'desatualizada'])
                    && request.resource.data.comentario is string && request.resource.data.comentario.size() <= 500
                    && request.resource.data.em == request.time
                    && (resource == null || resource.data.pergunta == request.resource.data.pergunta);
    }

    function temaValido(dados) {
      return !('tema' in dados) || (dados.tema is string && dados.tema.size() > 0 && dados.tema.size() <= 40);
    }
  }
}
