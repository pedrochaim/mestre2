# Questão (Nível Universitário):
# Resolva os seguintes sistemas lineares 2×2 e, para cada solução (x, y), calcule S = x + y.
# Armazene os quatro valores de S em um vetor chamado exsolution.
# Sistema (a)
A1 <- matrix(c( 2,  1,
1,  3), nrow = 2, byrow = TRUE)
b1 <- c(5, 8)
sol1 <- solve(A1, b1)      # sol1 é o vetor c(x, y)
S1   <- sum(sol1)          # soma das variáveis
# Sistema (b)
A2 <- matrix(c( 4, -1,
-2,  5), nrow = 2, byrow = TRUE)
b2 <- c(2,  7)
sol2 <- solve(A2, b2)
S2   <- sum(sol2)
# Sistema (c)
A3 <- matrix(c( 1,  2,
3, -1), nrow = 2, byrow = TRUE)
b3 <- c(4, 1)
sol3 <- solve(A3, b3)
S3   <- sum(sol3)
# Sistema (d)
A4 <- matrix(c( 5,  3,
-1,  2), nrow = 2, byrow = TRUE)
b4 <- c(11, 1)
sol4 <- solve(A4, b4)
S4   <- sum(sol4)
# Vetor com os resultados numéricos de cada item
exsolution <- c(S1, S2, S3, S4)
# Exiba o vetor exsolution
exsolution
