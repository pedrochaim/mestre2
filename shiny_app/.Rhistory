library(shiny)
library(jsonlite)
# Caminho dos arquivos JSON originais por subtema
json_dir <- "data"
tema_dir <- "temas"
if (!dir.exists(tema_dir)) dir.create(tema_dir)
# Mapear temas e cores
temas <- c("Geografia", "História Natural", "Variedades", "Artes", "Cotidiano",
"Ciências", "Entretenimento", "Esportes", "História")
cores <- c("#006400", "#90EE90", "#FFD700", "#FFA500", "#FF4500",
"#C71585", "#9370DB", "#87CEEB", "#00008B")
names(cores) <- temas
# Função para concatenar arquivos de subtemas em arquivos por tema
preparar_arquivos_por_tema <- function() {
arquivos <- list.files(json_dir, pattern = "\\.json$", full.names = TRUE)
dados <- lapply(arquivos, function(arquivo) {
fromJSON(arquivo)
})
todos <- do.call(rbind, dados)
todos <- as.data.frame(todos, stringsAsFactors = FALSE)
por_tema <- split(todos, todos$tema)
lapply(names(por_tema), function(nome_tema) {
jsonlite::write_json(por_tema[[nome_tema]],
path = file.path(tema_dir, paste0(nome_tema, ".json")),
pretty = TRUE, auto_unbox = TRUE)
})
}
# Rodar na inicialização do app
preparar_arquivos_por_tema()
runApp()
