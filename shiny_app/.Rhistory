# Gerando 4 sistemas 2x2 aleatórios com solução única
gerar_sistema <- function() {
repeat {
A <- matrix(sample(-5:5, 4, replace = TRUE), nrow = 2)
if (det(A) != 0) break
}
b <- sample(-10:10, 2)
sol <- solve(A, b)
list(A = A, b = b, sol = round(sol, 2))
}
s1 <- gerar_sistema()
s2 <- gerar_sistema()
s3 <- gerar_sistema()
s4 <- gerar_sistema()
# Soluções em um único vetor
exsolution <- c(s1$sol, s2$sol, s3$sol, s4$sol)
