set.seed(123)
simulate_and_get_roc <- function(M = 10000, n, d, sigma = 1, thresholds = seq(-3, 5, length.out = 500)) {
# Create labels: P(type 1) = 1/3, P(type 0) = 2/3
labels <- sample(c(0, 1), M, replace = TRUE, prob = c(2/3, 1/3))
# Simulate data and compute t-statistics
t_stats <- replicate(M, {
label <- sample(c(0, 1), 1, prob = c(2/3, 1/3))
mu <- ifelse(label == 0, 0, d)
x <- rnorm(n, mean = mu, sd = sigma)
t_stat <- mean(x) / (sd(x) / sqrt(n))
return(c(t_stat, label))
})
t_stats <- t(t_stats)
t_values <- t_stats[, 1]
true_labels <- t_stats[, 2]
# Compute ROC curve
roc_df <- data.frame(Threshold = thresholds, TPR = NA, FPR = NA)
for (i in seq_along(thresholds)) {
c <- thresholds[i]
preds <- ifelse(t_values > c, 1, 0)
TP <- sum(preds == 1 & true_labels == 1)
FP <- sum(preds == 1 & true_labels == 0)
FN <- sum(preds == 0 & true_labels == 1)
TN <- sum(preds == 0 & true_labels == 0)
roc_df$TPR[i] <- TP / (TP + FN)
roc_df$FPR[i] <- FP / (FP + TN)
}
roc_df$highlight <- abs(roc_df$Threshold - qnorm(0.95)) == min(abs(roc_df$Threshold - qnorm(0.95)))
roc_df$n <- n
roc_df$d <- d
return(roc_df)
}
# Experiment 1: Varying n
n_values <- seq(50, 200, 50)
roc_data_n <- bind_rows(lapply(n_values, function(n) simulate_and_get_roc(n = n, d = 0.25)))
ggplot(roc_data_n, aes(x = FPR, y = TPR, color = factor(n))) +
geom_line(size = 1) +
geom_point(data = filter(roc_data_n, highlight), color = "red", size = 2) +
geom_vline(xintercept = 0.05, linetype = "dashed") +
labs(title = "ROC Curves for Varying Sample Size (d = 0.25)",
x = "False Positive Rate", y = "True Positive Rate", color = "Sample Size (n)") +
theme_minimal() +
coord_equal()
