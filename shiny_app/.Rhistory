set.seed(42)  # for reproducibility
simulate_and_plot_roc <- function(M = 10000, n_list = NULL, d_list = NULL, sigma = 1, fixed_d = 0.25, fixed_n = 50) {
thresholds <- seq(-3, 5, length.out = 500)
c_fixed <- qnorm(1 - 0.05)  # approx. 1.645
roc_all <- data.frame()
# Generate imbalanced labels: type 1 is half as likely as type 0 => P(type 1) = 1/3
generate_labels <- function(M) {
sample(c(0, 1), M, replace = TRUE, prob = c(2/3, 1/3))
}
run_simulation <- function(n, d) {
labels <- generate_labels(M)
t_stats <- sapply(labels, function(label) {
mu <- ifelse(label == 0, 0, d)
x <- rnorm(n, mean = mu, sd = sigma)
t_j <- mean(x) / (sd(x) / sqrt(n))
return(t_j)
})
roc_data <- data.frame(Threshold = thresholds, TPR = NA, FPR = NA)
for (i in seq_along(thresholds)) {
c <- thresholds[i]
preds <- ifelse(t_stats > c, 1, 0)
TP <- sum(preds == 1 & labels == 1)
FP <- sum(preds == 1 & labels == 0)
FN <- sum(preds == 0 & labels == 1)
TN <- sum(preds == 0 & labels == 0)
roc_data$TPR[i] <- ifelse((TP + FN) == 0, NA, TP / (TP + FN))
roc_data$FPR[i] <- ifelse((FP + TN) == 0, NA, FP / (FP + TN))
}
roc_data$Highlight <- abs(roc_data$Threshold - c_fixed) == min(abs(roc_data$Threshold - c_fixed))
roc_data$n <- n
roc_data$d <- d
return(roc_data)
}
# Vary n (fixed d)
if (!is.null(n_list)) {
for (n in n_list) {
roc <- run_simulation(n, fixed_d)
roc_all <- bind_rows(roc_all, roc)
}
ggplot(roc_all, aes(x = FPR, y = TPR, color = factor(n))) +
geom_line(size = 1) +
geom_point(data = filter(roc_all, Highlight), color = "red", size = 2) +
geom_vline(xintercept = 0.05, linetype = "dashe_
