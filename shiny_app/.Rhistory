mtry = 2,
classification = TRUE,
importance = 'impurity',
probability = TRUE
)
test_length=100
Mmeans = vector(length=test_length)
Ssd = vector(length=test_length)
Ssize = vector(length=test_length)
LLabel = vector(length=test_length)
N = 100
for (j in 1:test_length){
mu = c(0, 0.1) |> sample(1)
smpl = rnorm(N, mean=mu, sd=1)
Mmeans[j] = mean(smpl)
Ssd[j] = sd(smpl)
if (mu==0){
LLabel[j] = -1
} else {
LLabel[j] = 1
}
}
ddat2 = data.frame("mean"=Mmeans, "sd"=Ssd, "label"=LLabel)
pred = predict(fit, data=ddat2)$predictions
out = apply(pred, 1, which.max)
out[out==1] = -1
out[out==2] = 1
mean(out == ddat2$label)
