list(nome = "História", arquivo = "historia.json", cor = "#00008B")
)
# 2. Função de carregamento - COM VERIFICAÇÕES
carregar_questoes <- function() {
dados <- list()
for (tema in temas_info) {
caminho <- file.path("data", tema$arquivo)
if (file.exists(caminho)) {
tryCatch({
# Carrega e verifica estrutura
questao_df <- fromJSON(caminho)
if (!all(c("id", "tema", "pergunta", "resposta", "fonte") %in% names(questao_df))) {
stop(paste("Arquivo", tema$arquivo, "não tem a estrutura esperada"))
}
# Garante que o tema está correto
questao_df$tema <- tema$nome
dados[[tema$nome]] <- questao_df
}, error = function(e) {
message("ERRO em ", tema$arquivo, ": ", e$message)
})
} else {
message("Arquivo não encontrado: ", caminho)
}
}
return(dados)
}
