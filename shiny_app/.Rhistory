inputId = paste0("btn_", gsub(" ", "_", tema)),
label = tema,
style = paste0("background-color: ", tema_cores[tema], "; color: white; margin-bottom: 10px; width: 100%;")
)
}),
width = 3
),
mainPanel(
h3(textOutput("tema_selecionado")),
br(),
uiOutput("pergunta_ui"),
br(),
actionButton("mostrar_resposta", "Mostrar Resposta"),
br(), br(),
uiOutput("resposta_ui"),
br(),
uiOutput("fonte_ui"),
width = 9
)
)
)
server <- function(input, output, session) {
tema_atual <- reactiveVal(NULL)
pergunta_atual <- reactiveVal(NULL)
# Observadores para cada botão, sorteia uma pergunta do tema
lapply(names(tema_cores), function(tema) {
observeEvent(input[[paste0("btn_", gsub(" ", "_", tema))]], {
tema_atual(tema)
questoes_tema <- questions %>% filter(tema == tema)
pergunta_atual(questoes_tema[sample(nrow(questoes_tema), 1), ])
output$resposta_ui <- renderUI(NULL)
})
})
output$tema_selecionado <- renderText({
req(tema_atual())
paste("Tema:", tema_atual())
})
output$pergunta_ui <- renderUI({
req(pergunta_atual())
tags$div(style = "font-size: 20px; font-weight: bold;", pergunta_atual()$pergunta)
})
output$resposta_ui <- renderUI({
req(pergunta_atual())
tags$div(style = "font-size: 18px; color: darkblue;", pergunta_atual()$resposta)
})
output$fonte_ui <- renderUI({
req(pergunta_atual())
tags$a(href = pergunta_atual()$fonte, "Fonte (Wikipedia - Inglês)", target = "_blank")
})
# Inicialmente resposta oculta, mostra quando clicar
observeEvent(input$mostrar_resposta, {
output$resposta_ui <- renderUI({
req(pergunta_atual())
tags$div(style = "font-size: 18px; color: darkblue;", pergunta_atual()$resposta)
})
})
# Esconde a resposta ao trocar de pergunta (feito dentro do observe de botões)
observe({
# Esconde resposta se mudar a pergunta
invalidateLater(1000)
if (is.null(pergunta_atual())) {
output$resposta_ui <- renderUI(NULL)
}
})
}
shinyApp(ui, server)
runApp()
rm(list=ls())
runApp()
