library(ggplot2)
library(dplyr)
set.seed(123)
# Simulation function
simulate_and_get_roc <- function(M = 10000, n, d, sigma = 1, thresholds = seq(-3, 5, length.out = 500)) {
# Generate labels: P(type 1) = 1/3, P(type 0) = 2/3
true_labels <- sample(c(0, 1), M, replace = TRUE, prob = c(2/3, 1/3))
# Simulate samples and compute t-statistics
t_stats <- sapply(true_labels, function(lbl) {
mu <- ifelse(lbl == 1, d, 0)
x <- rnorm(n, mean = mu, sd = sigma)
t_stat <- mean(x) / (sd(x) / sqrt(n))
return(t_stat)
})
# Compute ROC points
roc_df <- data.frame(Threshold = thresholds, TPR = NA, FPR = NA, Youden = NA)
for (i in seq_along(thresholds)) {
c <- thresholds[i]
preds <- ifelse(t_stats > c, 1, 0)
TP <- sum(preds == 1 & true_labels == 1)
FP <- sum(preds == 1 & true_labels == 0)
FN <- sum(preds == 0 & true_labels == 1)
TN <- sum(preds == 0 & true_labels == 0)
TPR <- ifelse((TP + FN) == 0, 0, TP / (TP + FN))
FPR <- ifelse((FP + TN) == 0, 0, FP / (FP + TN))
roc_df$TPR[i] <- TPR
roc_df$FPR[i] <- FPR
roc_df$Youden[i] <- TPR - FPR
}
# Identify points to highlight
roc_df$highlight_qnorm <- abs(roc_df$Threshold - qnorm(0.95)) == min(abs(roc_df$Threshold - qnorm(0.95)))
roc_df$highlight_youden <- roc_df$Youden == max(roc_df$Youden)
roc_df$n <- n
roc_df$d <- d
return(roc_df)
}
# ---- Experiment 1: Varying n ----
n_values <- seq(50, 200, 50)
roc_data_n <- bind_rows(lapply(n_values, function(n) simulate_and_get_roc(n = n, d = 0.25)))
ggplot(roc_data_n, aes(x = FPR, y = TPR, color = factor(n))) +
geom_line(size = 1) +
geom_point(data = filter(roc_data_n, highlight_qnorm), shape = 16, color = "red", size = 2, show.legend = FALSE) +
geom_point(data = filter(roc_data_n, highlight_youden), shape = 17, color = "blue", size = 2, show.legend = FALSE) +
geom_vline(xintercept = 0.05, linetype = "dashed") +
labs(title = "ROC Curves for Varying Sample Size (d = 0.25)",
x = "False Positive Rate", y = "True Positive Rate", color = "Sample Size (n)") +
theme_minimal() +
coord_equal()
# ---- Experiment 2: Varying d (n fixed) ----
d_values <- seq(0.1, 0.5, 0.1)
roc_data_d <- bind_rows(lapply(d_values, function(d) simulate_and_get_roc(n = 50, d = d)))
ggplot(roc_data_d, aes(x = FPR, y = TPR, color = factor(d))) +
geom_line(size = 1) +
geom_point(data = filter(roc_data_d, highlight_qnorm), shape = 16, color = "red", size = 2, show.legend = FALSE) +
geom_point(data = filter(roc_data_d, highlight_youden), shape = 17, color = "blue", size = 2, show.legend = FALSE) +
geom_vline(xintercept = 0.05, linetype = "dashed") +
labs(title = "ROC Curves for Varying Effect Size d (n = 50)",
x = "False Positive Rate", y = "True Positive Rate", color = "Effect Size (d)") +
theme_minimal() +
coord_equal()
