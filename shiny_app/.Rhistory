library(shiny)
library(jsonlite)
library(shinyjs)
# Definir cores dos temas
temas_cores <- c(
"Geografia" = "#006400",
"História Natural" = "#90EE90",
"Variedades" = "#FFFF00",
"Artes" = "#FFA500",
"Cotidiano" = "#FF0000",
"Ciências" = "#C71585",
"Entretenimento" = "#9370DB",
"Esportes" = "#ADD8E6",
"História" = "#00008B"
)
# Carregar todas as questões
carregar_questoes <- function() {
arquivos <- list.files("data", pattern = "\\.json$", full.names = TRUE)
todas_questoes <- list()
for (arquivo in arquivos) {
tema <- tools::file_path_sans_ext(basename(arquivo))
questoes <- fromJSON(arquivo)
todas_questoes[[tema]] <- questoes
}
return(todas_questoes)
}
questoes <- carregar_questoes()
# UI
ui <- fluidPage(
useShinyjs(),
titlePanel("Jogo de Perguntas e Respostas"),
sidebarLayout(
sidebarPanel(
width = 3,
h3("Temas"),
lapply(names(temas_cores), function(tema) {
actionButton(
inputId = paste0("btn_", gsub(" ", "_", tolower(tema))),
label = tema,
style = paste0("background-color:", temas_cores[tema], "; color: black; width: 100%; margin-bottom: 10px;")
)
})
),
mainPanel(
width = 9,
fluidRow(
column(
width = 8,
offset = 2,
wellPanel(
style = "min-height: 300px;",
h3(textOutput("tema_questao"), style = "color: #333;"),
hr(),
h4(textOutput("pergunta"), style = "min-height: 100px;"),
actionButton("mostrar_resposta", "Mostrar Resposta", style = "margin-top: 20px;"),
hidden(
div(
id = "resposta_container",
style = "margin-top: 20px; padding: 15px; background-color: #f5f5f5; border-radius: 5px;",
h4("Resposta:"),
textOutput("resposta"),
hr(),
h5("Fonte:"),
uiOutput("fonte_link")
)
)
)
)
)
)
)
)
# Server
server <- function(input, output, session) {
# Questão atual
questao_atual <- reactiveVal(NULL)
# Observadores para os botões de tema
lapply(names(temas_cores), function(tema) {
observeEvent(input[[paste0("btn_", gsub(" ", "_", tolower(tema)))]], {
questoes_tema <- questoes[[tolower(gsub(" ", "_", tema))]]
if (length(questoes_tema) > 0) {
questao_sorteada <- questoes_tema[[sample(1:length(questoes_tema), 1)]]
questao_atual(questao_sorteada)
hide("resposta_container")
}
})
})
# Mostrar resposta
observeEvent(input$mostrar_resposta, {
show("resposta_container")
})
# Atualizar outputs
output$tema_questao <- renderText({
if (!is.null(questao_atual())) {
questao_atual()$tema
} else {
"Selecione um tema para começar"
}
})
output$pergunta <- renderText({
if (!is.null(questao_atual())) {
questao_atual()$pergunta
} else {
""
}
})
output$resposta <- renderText({
if (!is.null(questao_atual())) {
questao_atual()$resposta
} else {
""
}
})
output$fonte_link <- renderUI({
if (!is.null(questao_atual())) {
tags$a(href = questao_atual()$fonte, questao_atual()$fonte, target = "_blank")
}
})
}
# Rodar aplicação
shinyApp(ui = ui, server = server)
runApp()
runApp()
runApp()
library(shiny)
library(jsonlite)
library(shinyjs)
library(stringr)
# Definir cores dos temas com mapeamento de nomes
temas_info <- list(
"Geografia" = list(file = "geografia.json", color = "#006400"),
"História Natural" = list(file = "historia_natural.json", color = "#90EE90"),
"Variedades" = list(file = "variedades.json", color = "#FFFF00"),
"Artes" = list(file = "artes.json", color = "#FFA500"),
"Cotidiano" = list(file = "cotidiano.json", color = "#FF0000"),
"Ciências" = list(file = "ciencias.json", color = "#C71585"),
"Entretenimento" = list(file = "entretenimento.json", color = "#9370DB"),
"Esportes" = list(file = "esportes.json", color = "#ADD8E6"),
"História" = list(file = "historia.json", color = "#00008B")
)
# Carregar todas as questões com mapeamento consistente
carregar_questoes <- function() {
todas_questoes <- list()
for (tema in names(temas_info)) {
arquivo <- file.path("data", temas_info[[tema]]$file)
if (file.exists(arquivo)) {
# Ler o JSON garantindo a estrutura correta
tryCatch({
questoes <- fromJSON(arquivo, simplifyDataFrame = TRUE)
# Verificar e padronizar a estrutura
if (is.data.frame(questoes)) {
# Garantir que o campo 'tema' está correto
questoes$tema <- tema
todas_questoes[[tema]] <- questoes
} else {
stop(paste("Formato inválido no arquivo:", arquivo))
}
}, error = function(e) {
message(paste("Erro ao carregar", arquivo, ":", e$message))
})
}
}
return(todas_questoes)
}
questoes <- carregar_questoes()
# UI com botões baseados no mapeamento
ui <- fluidPage(
useShinyjs(),
titlePanel("Jogo de Perguntas e Respostas"),
sidebarLayout(
sidebarPanel(
width = 3,
h3("Temas"),
lapply(names(temas_info), function(tema) {
actionButton(
inputId = paste0("btn_", gsub(" ", "_", tolower(tema))),
label = tema,
style = paste0("background-color:", temas_info[[tema]]$color,
"; color: black; width: 100%; margin-bottom: 10px;")
)
})
),
mainPanel(
# ... (o mesmo layout anterior)
)
)
)
# Server com tratamento seguro
server <- function(input, output, session) {
questao_atual <- reactiveVal(NULL)
# Observadores para os botões usando mapeamento consistente
lapply(names(temas_info), function(tema) {
observeEvent(input[[paste0("btn_", gsub(" ", "_", tolower(tema)))]], {
tryCatch({
if (!is.null(questoes[[tema]]) && nrow(questoes[[tema]]) > 0) {
questao_sorteada <- as.list(questoes[[tema]][sample(nrow(questoes[[tema]]), 1), ])
questao_atual(questao_sorteada)
hide("resposta_container")
}
}, error = function(e) {
showNotification(paste("Erro ao carregar questão:", e$message), type = "error")
})
})
})
# ... (o resto do server permanece igual)
}
shinyApp(ui = ui, server = server)
runApp()
runApp()
rm(list=ls())
runApp()
runApp()
